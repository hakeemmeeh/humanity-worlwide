# ---- Supabase (create a NEW project for HWW) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Settings -> API -> service_role (server only, never expose)

# ---- Admin login ----
# ADMIN_PASSWORD: what staff type on /admin-login (use a long passphrase)
# ADMIN_SESSION_SECRET: 32+ random chars, used to SIGN session cookies (never the cookie value itself)
#   generate: openssl rand -base64 48
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---- Email notifications (optional but recommended) ----
RESEND_API_KEY=
NOTIFY_EMAIL=cd@humanity-worldwide.org
NOTIFY_FROM="HWW Website <onboarding@resend.dev>"   # use a verified domain sender in production
